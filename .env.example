# Copy this file to ".env" and fill in ONE key. Restart the server after editing.
#
# Without any key everything still runs. Reports use deterministic templates:
# identical numbers, plainer prose.

# ---- Option A: Google Gemini (has a free tier, no credit card) --------------
# Get a key: https://aistudio.google.com/apikey
# Install:   pip install google-genai
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# free (default) -> 2 concurrent calls, 5 LLM calls per report
# paid           -> 8 concurrent calls, 40 per report. Set this once billing is on.
GEMINI_TIER=free

# ---- Option B: Anthropic ---------------------------------------------------
# Get a key: https://console.anthropic.com  ->  API Keys
# Install:   pip install anthropic
# ANTHROPIC_API_KEY=

# ---- Which one to use ------------------------------------------------------
# gemini | anthropic | none    (blank = whichever key is present, Gemini first)
LLM_PROVIDER=gemini

# ---- Job description extraction --------------------------------------------
# auto  (default) use the model only once every JD in a report is cached,
#                 warming the cache a little on each run
# llm             force model extraction even at partial coverage
# regex           never call the model for JD parsing
JD_EXTRACT=auto

# ---- Database --------------------------------------------------------------
# Default: SQLite at rejectionintel.db in the project root. No install needed.
# For production, point this at Postgres and nothing else changes:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/rejectionintel
# DATABASE_URL=

# ---- Auth ------------------------------------------------------------------
# Signing key for session cookies and magic links. If unset, one is generated
# and written to .secret_key on first run. Set it explicitly in production —
# changing it signs everyone out.
# SECRET_KEY=

# Set to 1 behind HTTPS. A Secure cookie is silently dropped over plain HTTP,
# which presents as "sign-in does nothing" with no error anywhere.
# COOKIE_SECURE=1

# With no SMTP_URL the magic link is printed to the console and returned in the
# response instead of emailed.
# SMTP_URL=

# ---- Background queue -------------------------------------------------------
# memory (default) runs jobs in-process. Adequate until two uploads regularly
# overlap or jobs need to survive a restart.
# QUEUE_BACKEND=rq
# REDIS_URL=redis://localhost:6379/0
# RQ_QUEUE=analysis
#   pip install rq redis
#   rq worker analysis --url redis://localhost:6379/0

# ---- Easy-language register ------------------------------------------------
# coach (default) plain conversational English, roughly 8th-grade reading level
# hinglish        casual Hinglish in Roman script
# EASY_STYLE=coach

# ---- Email delivery ---------------------------------------------------------
# Unset -> magic links print to the server log (development only).
# APP_URL must be the public URL, or the link in the email points at localhost.
# APP_URL=https://rejectionintel.com
# MAIL_FROM=hello@rejectionintel.com
# MAIL_FROM_NAME=RejectionIntel
# RESEND_API_KEY=re_...
# or instead of Resend:
# SMTP_URL=smtps://user:pass@smtp.provider.com:465
#
# Before real users: add SPF, DKIM and DMARC records for the sending domain.
# Without them transactional mail is routinely filtered, and a sign-in link in
# a spam folder is indistinguishable from a broken product.
